 <script setup>
 import RefreshIcon from '@/components/Icons/RefreshIcon.vue'
 import IndicatorIcon from '@/components/Icons/IndicatorIcon.vue'
 import { isTouchScreenDevice, colors, parseColor } from '@/utils'
+import { resolveExtension } from '@/extensions'
 import Draggable from 'vuedraggable'
 import { Combobox, Dropdown, Popover } from 'frappe-ui'
 import { computed } from 'vue'
@@ -198,6 +226,36 @@ const emit = defineEmits(['update', 'loadMore'])
 
 const kanban = defineModel({ type: Object })
 
+// Extension points registered for this board's doctype (src/extensions.js)
+const ext = computed(() => {
+  const doctype = kanban.value?.params?.doctype
+  return {
+    boardHead: resolveExtension('kanban.board-head', doctype),
+    columnMeta: resolveExtension('kanban.column-meta', doctype),
+    card: resolveExtension('kanban.card', doctype),
+  }
+})
+
+function columnInfo(column) {
+  return {
+    name: column.column.name,
+    count: column.column.count,
+    allCount: column.column.all_count,
+  }
+}
+
+// What extensions get to know about the board: plain data, not the resource
+const board = computed(() => ({
+  doctype: kanban.value?.params?.doctype,
+  columnField: kanban.value?.data?.column_field,
+  filters: kanban.value?.params?.filters || {},
+  defaultFilters: kanban.value?.params?.default_filters || {},
+  columns: (kanban.value?.data?.data || []).map((column) => ({
+    ...columnInfo(column),
+    items: (column.data || []).map((item) => item.name),
+  })),
+}))
+
 const titleField = computed(() => {
   return kanban.value?.data?.title_field
 })

+	def on_trash(self):
+		"""Notes written on the task stay on its lead or deal; with none, they go with the task."""
+		# a note's reference is a dynamic link, which would otherwise stop the task being deleted
+		parent = {"reference_doctype": self.reference_doctype, "reference_docname": self.reference_docname}
+		for note in frappe.get_all(
+			"FCRM Note", filters={"reference_doctype": self.doctype, "reference_docname": str(self.name)}
+		):
+			if self.reference_doctype and self.reference_docname:
+				frappe.db.set_value("FCRM Note", note.name, parent, update_modified=False)
+			else:
+				frappe.delete_doc("FCRM Note", note.name, ignore_permissions=True)
+
 	def unassign_from_previous_user(self, user: str | None):
 		if user:
 			unassign(self.doctype, self.name, user)

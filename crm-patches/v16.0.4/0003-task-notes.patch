diff --git a/crm/api/task.py b/crm/api/task.py
new file mode 100644
index 0000000..4708dc5
--- /dev/null
+++ b/crm/api/task.py
@@ -0,0 +1,176 @@
+"""Notes on tasks, and the note written when a task changes status.
+
+A note written on a task is an ordinary FCRM Note that references the task
+(`reference_doctype` "CRM Task"), so no field is added to the note. The lead's or deal's
+Notes tab and timeline include the notes on its tasks (`activities.get_linked_notes`),
+and the notes follow the task if it moves to another record. The status change a note
+was written for is in its title ("Done: ...").
+
+Apps can suggest the note's title by listing a function in the `crm_task_note_title`
+hook: `fn(context: dict) -> str | None`, see `suggest_note_title`.
+"""
+
+import frappe
+from frappe import _
+from frappe.utils import strip_html_tags
+
+NOTE_FIELDS = ["name", "title", "content", "pinned", "owner", "modified", "creation"]
+
+
+@frappe.whitelist()
+def get_notes(task: str | int):
+	"""The task's notes, newest first."""
+	frappe.get_doc("CRM Task", task).check_permission("read")
+	return frappe.get_list(
+		"FCRM Note",
+		filters={"reference_doctype": "CRM Task", "reference_docname": str(task)},
+		fields=NOTE_FIELDS,
+		order_by="creation desc",
+	)
+
+
+@frappe.whitelist()
+def add_note(task: str | int, title: str, content: str | None = None):
+	"""Write a note on a task, without changing the task."""
+	doc = frappe.get_doc("CRM Task", task)
+	doc.check_permission("write")
+	return _insert_note(doc, title, content).as_dict()
+
+
+@frappe.whitelist()
+def set_status(task: str | int, status: str, note: dict | str | None = None):
+	"""Change a task's status and, if given, write its note, in one request: both or neither.
+
+	`note` is `{"title": ..., "content": ...}`. Leave it out to change the status alone.
+	"""
+	note = frappe.parse_json(note) if note else None
+	if note and not (note.get("title") or "").strip():
+		frappe.throw(_("A note needs a title"), title=_("Missing Title"))
+
+	doc = frappe.get_doc("CRM Task", task)
+	doc.check_permission("write")
+	if doc.status != status:
+		doc.status = status
+		doc.save()
+
+	if note:
+		_insert_note(doc, note["title"], note.get("content"))
+	return doc.as_dict()
+
+
+def _insert_note(task, title: str, content: str | None):
+	return frappe.get_doc(
+		{
+			"doctype": "FCRM Note",
+			"title": title.strip(),
+			"content": content,
+			"reference_doctype": "CRM Task",
+			"reference_docname": str(task.name),
+		}
+	).insert()
+
+
+@frappe.whitelist()
+def get_title_context(task: str | int):
+	"""The names a note's title is built from: `{"deal": ..., "contact": ...}`, each maybe None.
+
+	`deal` is the organization of the task's deal or lead, or the person's name when it has
+	none. `contact` is the deal's primary contact (the first one if none is primary), or the
+	lead's person when the lead has an organization.
+	"""
+	doc = frappe.get_doc("CRM Task", task)
+	doc.check_permission("read")
+	return _title_names(doc)
+
+
+def _title_names(task):
+	if task.reference_doctype not in ("CRM Lead", "CRM Deal") or not task.reference_docname:
+		return {"deal": None, "contact": None}
+
+	record = frappe.db.get_value(
+		task.reference_doctype, task.reference_docname, ["organization", "lead_name"], as_dict=True
+	)
+	if not record:
+		return {"deal": None, "contact": None}
+
+	if task.reference_doctype == "CRM Deal":
+		contacts = frappe.get_all(
+			"CRM Contacts",
+			filters={"parenttype": "CRM Deal", "parent": task.reference_docname},
+			fields=["full_name"],
+			order_by="is_primary desc, idx asc",
+			limit=1,
+		)
+		contact = contacts[0].full_name if contacts else None
+	else:
+		contact = record.lead_name if record.organization else None
+
+	return {"deal": record.organization or record.lead_name or None, "contact": contact or None}
+
+
+@frappe.whitelist()
+def suggest_note_title(task: str | int, status_from: str, status_to: str, content: str | None = None):
+	"""A short title for the note about to be written, from an app's `crm_task_note_title` hook.
+
+	Returns `{"subject": str}`, or None when no app suggests one or the hook fails. The
+	caller puts the subject in the title in place of the task's own title, between the
+	new status and the deal and contact names. The hook gets:
+
+	    task         {name, title, due_date, priority}
+	    status_from, status_to
+	    parent       {doctype, name, title, status}, or None
+	    names        {deal, contact}, each maybe None: the title already says them
+	    content      the note's text without markup
+	"""
+	try:
+		suggester = _title_suggester()
+	except Exception:
+		frappe.log_error(title="Task note title hook not found")
+		return None
+	if not suggester:
+		return None
+
+	doc = frappe.get_doc("CRM Task", task)
+	doc.check_permission("read")
+	context = {
+		"task": {
+			"name": doc.name,
+			"title": doc.title,
+			"due_date": str(doc.due_date) if doc.due_date else None,
+			"priority": doc.priority,
+		},
+		"status_from": status_from,
+		"status_to": status_to,
+		"parent": _parent(doc),
+		"names": _title_names(doc),
+		"content": strip_html_tags(content or "").strip(),
+	}
+	try:
+		subject = suggester(context)
+	except Exception:
+		frappe.log_error(title="Task note title suggestion failed")
+		return None
+	return {"subject": subject} if isinstance(subject, str) and subject.strip() else None
+
+
+def _title_suggester():
+	"""The function of the last app that lists one under `crm_task_note_title`, if any."""
+	hooks = frappe.get_hooks("crm_task_note_title")
+	return frappe.get_attr(hooks[-1]) if hooks else None
+
+
+def _parent(task):
+	if task.reference_doctype not in ("CRM Lead", "CRM Deal") or not task.reference_docname:
+		return None
+	title_fields = ["lead_name"] if task.reference_doctype == "CRM Lead" else ["organization", "lead_name"]
+	record = frappe.db.get_value(
+		task.reference_doctype, task.reference_docname, [*title_fields, "status"], as_dict=True
+	)
+	if not record:
+		return None
+	return {
+		"doctype": task.reference_doctype,
+		"name": task.reference_docname,
+		"title": next((record[f] for f in title_fields if record.get(f)), task.reference_docname),
+		"status": record.status,
+	}

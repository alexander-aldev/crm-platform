@@ -0,0 +1,134 @@
+<template>
+  <div class="mt-5 border-t border-outline-gray-2 pt-4">
+    <div class="mb-3 flex items-center justify-between">
+      <div class="text-lg-medium text-ink-gray-8">
+        {{ __('Notes') }}
+        <span v-if="notes.data?.length" class="text-ink-gray-5">
+          {{ notes.data.length }}
+        </span>
+      </div>
+      <Button
+        v-if="!adding"
+        variant="ghost"
+        icon-left="lucide-plus"
+        :label="__('Add note')"
+        @click="adding = true"
+      />
+    </div>
+
+    <div v-if="adding" class="mb-4 flex flex-col gap-2">
+      <FormControl
+        v-model="title"
+        type="text"
+        :placeholder="__('Title')"
+        autofocus
+      />
+      <TextEditorControl
+        :value="content"
+        :fixedMenu="false"
+        :placeholder="__('What happened?')"
+        @change="(v) => (content = v)"
+      />
+      <ErrorMessage v-if="error" :message="error" />
+      <div class="flex justify-end gap-2">
+        <Button :label="__('Cancel')" @click="reset" />
+        <Button
+          variant="solid"
+          :label="__('Save note')"
+          :loading="saving"
+          @click="save"
+        />
+      </div>
+    </div>
+
+    <div
+      v-for="note in notes.data"
+      :key="note.name"
+      class="border-b border-outline-gray-1 py-2 last:border-0"
+    >
+      <div class="flex items-center justify-between gap-3">
+        <div class="flex min-w-0 items-center gap-1.5">
+          <div class="truncate text-base font-medium text-ink-gray-9">
+            {{ note.title }}
+          </div>
+        </div>
+        <div class="flex shrink-0 items-center gap-2 text-sm text-ink-gray-5">
+          <span>{{ getUser(note.owner).full_name }}</span>
+          <TimelineTimestamp :date="note.creation" />
+        </div>
+      </div>
+      <!-- content is passed through sanitizeHTML() (DOMPurify) before rendering, so v-html is safe here -->
+      <!-- eslint-disable vue/no-v-html -->
+      <div
+        v-if="note.content"
+        class="prose-f prose-sm mt-1 line-clamp-3 max-w-none text-p-sm text-ink-gray-6"
+        v-html="sanitizeHTML(note.content)"
+      />
+      <!-- eslint-enable vue/no-v-html -->
+    </div>
+    <div
+      v-if="!notes.data?.length && !adding"
+      class="py-2 text-sm text-ink-gray-5"
+    >
+      {{ __('No notes on this task yet') }}
+    </div>
+  </div>
+</template>
+<script setup>
+import TextEditorControl from '@/components/Controls/TextEditorControl.vue'
+import TimelineTimestamp from '@/components/Activities/TimelineTimestamp.vue'
+import { usersStore } from '@/stores/users'
+import { sanitizeHTML } from '@/utils'
+import { Button, ErrorMessage, FormControl, call, createResource } from 'frappe-ui'
+import { ref } from 'vue'
+
+const props = defineProps({
+  task: { type: [String, Number], required: true },
+})
+
+// the note is written on the task's lead or deal too, so refresh what that page shows
+const emit = defineEmits(['added'])
+
+const { getUser } = usersStore()
+
+const notes = createResource({
+  url: 'crm.api.task.get_notes',
+  params: { task: props.task },
+  auto: true,
+})
+
+const adding = ref(false)
+const title = ref('')
+const content = ref('')
+const error = ref('')
+const saving = ref(false)
+
+function reset() {
+  adding.value = false
+  title.value = ''
+  content.value = ''
+  error.value = ''
+}
+
+async function save() {
+  if (!title.value.trim()) {
+    error.value = __('A note needs a title')
+    return
+  }
+  saving.value = true
+  try {
+    await call('crm.api.task.add_note', {
+      task: props.task,
+      title: title.value,
+      content: content.value,
+    })
+    reset()
+    notes.reload()
+    emit('added')
+  } catch (e) {
+    error.value = e.messages?.[0] || __('Could not save the note')
+  } finally {
+    saving.value = false
+  }
+}
+</script>

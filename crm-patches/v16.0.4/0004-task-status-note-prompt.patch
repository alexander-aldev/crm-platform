+          <span class="lucide-arrow-right size-3.5 text-ink-gray-5" />
+          <TaskStatusIcon :status="to" />
+          <span>{{ __(to) }}</span>
+        </div>
+        <div class="flex flex-col gap-3">
+          <div>
+            <div class="mb-2 flex items-center justify-between text-sm text-ink-gray-5">
+              <span>{{ __('Title') }}</span>
+              <Button
+                v-if="canSuggest && suggestionsAvailable"
+                variant="ghost"
+                size="sm"
+                icon-left="lucide-sparkles"
+                :label="__('Suggest')"
+                :loading="suggesting"
+                :tooltip="__('Write the title from the note')"
+                @click="suggest(true)"
+              />
+            </div>
+            <FormControl
+              type="text"
+              :modelValue="title"
+              @update:modelValue="onTitleInput"
+            />
+          </div>
+          <div>
+            <div class="mb-2 text-sm text-ink-gray-5">{{ __('Note') }}</div>
+            <TextEditorControl
+              :value="content"
+              :fixedMenu="false"
+              :mentions="true"
+              :placeholder="__('What happened?')"
+              @input="onContentInput"
+              @change="onContentBlur"
+            />
+          </div>
+        </div>
+      </div>
+    </template>
+    <template #actions>
+      <div class="flex items-center justify-between gap-2">
+        <div><ErrorMessage :message="error" /></div>
+        <div class="flex gap-2">
+          <Button :label="__('Cancel')" @click="cancel" />
+          <Button :label="__('Skip')" @click="skip" />
+          <Button
+            variant="solid"
+            :label="__('Save note')"
+            :disabled="!canSave"
+            @click="save"
+          />
+        </div>
+      </div>
+    </template>
+  </Dialog>
+</template>
+<script setup>
+import TaskStatusIcon from '@/components/Icons/TaskStatusIcon.vue'
+import TextEditorControl from '@/components/Controls/TextEditorControl.vue'
+import { plainText, taskNoteTitle } from '@/utils/taskNoteTitle'
+import { Button, Dialog, ErrorMessage, FormControl, call } from 'frappe-ui'
+import { computed, nextTick, onBeforeUnmount, onMounted, ref } from 'vue'
+
+// the title is suggested once the note has this much text, a second after typing stops
+const SUGGEST_MIN_CHARS = 20
+const SUGGEST_DELAY = 1000
+const SUGGEST_TIMEOUT = 4000
+
+const props = defineProps({
+  task: { type: Object, required: true },
+  from: { type: String, required: true },
+  to: { type: String, required: true },
+})
+
+const emit = defineEmits(['resolve'])
+
+const open = ref(true)
+// The title is built from the task and the new status at once; the deal and contact names
+// arrive a moment later, and an app's suggestion once there is text. Each rebuilds it.
+let names = {}
+let suggestedSubject = ''
+const buildTitle = () =>
+  taskNoteTitle({
+    task: props.task,
+    from: props.from,
+    to: props.to,
+    subject: suggestedSubject,
+    ...names,
+  })
+const title = ref(buildTitle())
+const content = ref('')
+const error = ref('')
+
+// the title is ours until the person types in it
+const titleEdited = ref(false)
+// false once the server says no app suggests titles, so the button goes away
+const suggestionsAvailable = ref(true)
+const suggesting = ref(false)
+
+const text = computed(() => plainText(content.value))
+const canSuggest = computed(() => text.value.length >= SUGGEST_MIN_CHARS)
+const canSave = computed(
+  () => title.value.trim() && (text.value || titleEdited.value),
+)
+
+let settled = false
+// saving from the keyboard blurs the editor first; that must not ask for a title
+let closing = false
+let timer = null
+let latestRequest = 0
+let suggestedFor = ''
+
+// Add the deal and contact to the title, unless the person has changed it
+async function fillTitleContext() {
+  try {
+    const result = await withTimeout(
+      call('crm.api.task.get_title_context', { task: props.task.name }),
+      SUGGEST_TIMEOUT,
+    )
+    if (settled) return
+    names = result || {}
+    if (!titleEdited.value) title.value = buildTitle()
+  } catch {
+    // the title without them stays
+  }
+}
+
+onMounted(fillTitleContext)
+
+function onTitleInput(value) {
+  title.value = value
+  titleEdited.value = true
+  error.value = ''
+}
+
+function onContentInput(value) {
+  content.value = value
+  clearTimeout(timer)
+  timer = setTimeout(() => suggest(false), SUGGEST_DELAY)
+}
+
+function onContentBlur(value) {
+  content.value = value
+  suggest(false)
+}
+
+// Ask the server for a short subject. Without `force` it only replaces a title
+// nobody has edited, and only for text it has not already been asked about.
+async function suggest(force = false) {
+  clearTimeout(timer)
+  if (settled || closing || !canSuggest.value || !suggestionsAvailable.value) return
+  if (!force && (titleEdited.value || text.value === suggestedFor)) return
+
+  const request = ++latestRequest
+  const asked = text.value
+  suggesting.value = true
+  try {
+    const result = await withTimeout(
+      call('crm.api.task.suggest_note_title', {
+        task: props.task.name,
+        status_from: props.from,
+        status_to: props.to,
+        content: content.value,
+      }),
+      SUGGEST_TIMEOUT,
+    )
+    // a newer request, or the dialog closing, makes this answer stale
+    if (request !== latestRequest || settled) return
+    suggestedFor = asked
+    if (!result?.subject) {
+      suggestionsAvailable.value = false
+      return
+    }
+    if (titleEdited.value && !force) return
+    suggestedSubject = result.subject.trim()
+    title.value = buildTitle()
+    titleEdited.value = false
+  } catch {
+    // slow or failing: the title we have stays
+  } finally {
+    if (request === latestRequest) suggesting.value = false
+  }
+}
+
+function withTimeout(promise, ms) {
+  return Promise.race([
+    promise,
+    new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), ms)),
+  ])
+}
+
+function settle(result) {
+  if (settled) return
+  settled = true
+  clearTimeout(timer)
+  open.value = false
+  emit('resolve', result)
+}
+
+async function save() {
+  // editors hand over their text on blur, so blur first when saving from the keyboard
+  closing = true
+  window.document.activeElement?.blur()
+  await nextTick()
+  if (!title.value.trim()) {
+    error.value = __('A note needs a title')
+    closing = false
+    return
+  }
+  if (!canSave.value) {
+    closing = false
+    return
+  }
+  settle({
+    action: 'save',
+    note: { title: title.value.trim(), content: content.value },
+  })
+}
+
+function skip() {
+  settle({ action: 'skip' })
+}
+
+function cancel() {
+  settle({ action: 'cancel' })
+}
+
+onBeforeUnmount(() => {
+  settled = true
+  clearTimeout(timer)
+})
+</script>

--- /dev/null
+++ b/frontend/src/utils/taskNoteTitle.js
@@ -0,0 +1,78 @@
+// The title proposed for the note written when a task changes status:
+//
+//   {New status}, {Task} / {Deal}, {Contact}
+//
+// "Done, Follow up / Kuehne + Nagel, Shirish Ekbote". The status leads, so a list of notes
+// reads by outcome; then what the task was, and whose it is. A part that is not known (a
+// task with no deal, a deal with no contact) is left out. When an app suggests a subject
+// from the note's text (server hook `crm_task_note_title`), it takes the place of the task.
+
+const SUBJECT_MAX = 40
+const TASK_MAX = 60
+// FCRM Note's title is a Data field
+const TITLE_MAX = 140
+
+// The task's title, tidied: spaces collapsed, reply prefixes ("Re:", "Fwd:", "AW:")
+// removed, first letter capitalised, cut at a word boundary when long.
+export function taskSubject(title, max = SUBJECT_MAX) {
+  let subject = (title || '')
+    .replace(/\s+/g, ' ')
+    .trim()
+    .replace(/^((re|fwd?|aw)\s*:\s*)+/i, '')
+  subject = subject.charAt(0).toUpperCase() + subject.slice(1)
+  if (subject.length <= max) return subject
+  const cut = subject.slice(0, max)
+  const words = cut.includes(' ') ? cut.slice(0, cut.lastIndexOf(' ')) : cut
+  return words.replace(/[,;:\- ]+$/, '') + '…'
+}
+
+// A note's text without markup, for judging whether there is enough to summarise.
+export function plainText(html) {
+  return (html || '')
+    .replace(/<[^>]*>/g, ' ')
+    .replace(/&nbsp;/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim()
+}
+
+// The task's title without the names the title already carries elsewhere: "Follow up:
+// Shirish Ekbote, Kuehne + Nagel" under the deal "Kuehne + Nagel" and the contact
+// "Shirish Ekbote" is "Follow up". Names are matched whole and ignoring case, and the
+// separators and connectors ("with", "at") they leave dangling are removed too.
+export function withoutNames(title, names) {
+  let text = title || ''
+  for (const name of names) {
+    const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+    text = text.replace(
+      new RegExp(`(?<![\\p{L}\\p{N}])${escaped}(?![\\p{L}\\p{N}])`, 'giu'),
+      '',
+    )
+  }
+  if (text === (title || '')) return text
+  return text
+    .replace(/\(\s*\)/g, '')
+    .replace(/\s+/g, ' ')
+    .replace(/\s*([,;:])(\s*[,;:])+/g, '$1')
+    .replace(/^[\s,;:\-–—|/@&]+/, '')
+    .replace(/(?:[\s,;:\-–—|/@&]|\b(?:with|at|for|to|from|of|and|re)\b)+$/i, '')
+    .trim()
+}
+
+// `deal` and `contact` are the names from `crm.api.task.get_title_context`; `subject` is
+// what an app suggested from the note's text, in place of the task's title. The task part
+// is cut to fit what is left of the title's length once the other parts are in.
+export function taskNoteTitle({ task, to, deal, contact, subject }) {
+  const status = (to || '').trim()
+  const names = [deal, contact].map((name) => (name || '').trim()).filter(Boolean)
+  // a contact that is the deal's name would only say it twice
+  if (names.length === 2 && names[0].toLowerCase() === names[1].toLowerCase()) names.pop()
+  const whose = names.join(', ')
+  const tail = whose ? ` / ${whose}` : ''
+  const lead = status ? `${status}, ` : ''
+  const max = Math.max(
+    SUBJECT_MAX / 2,
+    Math.min(TASK_MAX, TITLE_MAX - lead.length - tail.length),
+  )
+  const said = withoutNames(subject, names) || withoutNames(task?.title, names)
+  return `${[status, taskSubject(said, max)].filter(Boolean).join(', ')}${tail}`
+}

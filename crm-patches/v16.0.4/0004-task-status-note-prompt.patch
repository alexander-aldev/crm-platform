+// Changing a task's status asks for a note about it; the note can be skipped
+async function updateTaskStatus(status, task) {
+  if (status === task.status) return
+  const answer = await promptTaskStatusNote(task, task.status, status)
+  if (answer.action === 'cancel') return
+
+  const note = answer.action === 'save' ? answer.note : null

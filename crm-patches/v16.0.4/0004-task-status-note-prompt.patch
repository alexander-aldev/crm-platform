+import { ref } from 'vue'
+
+/**
+ * Open prompts, rendered by TaskStatusNoteContainer in GlobalModals.vue.
+ */
+export const taskStatusNotePrompts = ref([])
+
+/**
+ * Ask for a note when a task changes status. Resolves with
+ *   { action: 'save', note: { title, content } }  write the note
+ *   { action: 'skip' }                             change the status, no note
+ *   { action: 'cancel' }                           leave the status as it was
+ *
+ * @param {object} task - the task as loaded: { name, title, due_date, ... }
+ * @param {string} from - the status it has
+ * @param {string} to   - the status it is being given
+ */
+export function promptTaskStatusNote(task, from, to) {
+  return new Promise((resolve) => {
+    let resolved = false
+    const entry = {
+      key: `tsn-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
+      task,
+      from,
+      to,
+      resolve: (result) => {
+        if (resolved) return
+        resolved = true
+        resolve(result)
+        // let the dialog finish closing before it is removed
+        setTimeout(() => {
+          const i = taskStatusNotePrompts.value.indexOf(entry)
+          if (i !== -1) taskStatusNotePrompts.value.splice(i, 1)
+        }, 300)
+      },
+    }
+    taskStatusNotePrompts.value.push(entry)
+  })
+}
diff --git a/frontend/src/utils/taskNoteTitle.js b/frontend/src/utils/taskNoteTitle.js
new file mode 100644
